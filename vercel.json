{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "0 2 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/notifications/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/webhooks/razorpay/route.ts": {
      "maxDuration": 30
    }
  }
}
