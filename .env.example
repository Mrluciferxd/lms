# =============================================================================
# Deployment identity
# =============================================================================
# Selects which brands/<key>/brand.config.ts is active. One brand per deployment.
NEXT_PUBLIC_BRAND=nirlep-forex
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms?schema=public
# Prisma Migrate needs a direct (non-pooled) connection when DATABASE_URL is pooled.
DIRECT_URL=
# Only used by `prisma migrate diff` for the CI schema-drift check. The database
# must exist; Prisma resets its contents around each run.
SHADOW_DATABASE_URL=

# =============================================================================
# Auth
# =============================================================================
# openssl rand -base64 32
AUTH_SECRET=

# AUTH_URL is optional and usually should be left unset — `trustHost: true`
# derives the origin from the incoming request, which is what you want both
# locally and behind a proxy. Set it only if your proxy does not forward the
# host correctly; note that pinning it breaks sign-in redirects whenever the
# app is reached on a different origin than the one configured.
# AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# =============================================================================
# Payments — Razorpay
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in the Razorpay dashboard when creating the webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=

# =============================================================================
# Video — Bunny Stream (per brand.config integrations.video)
# =============================================================================
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Used to sign short-TTL playback URLs. Never expose to the client.
BUNNY_STREAM_TOKEN_AUTH_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# =============================================================================
# Object storage — worksheets, submissions, chat attachments
# =============================================================================
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# =============================================================================
# Notification channels
# =============================================================================
RESEND_API_KEY=
EMAIL_FROM="Nirlep Forex <no-reply@nirlepforex.com>"

MSG91_AUTH_KEY=
MSG91_SENDER_ID=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Web push — npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# =============================================================================
# Third-party data feeds
#
# Per section 3 of the proposal these subscriptions are the client's cost, not
# ours. The economic calendar widget degrades to a setup notice when unset —
# it does not error.
# =============================================================================
ECONOMIC_CALENDAR_API_URL=
ECONOMIC_CALENDAR_API_KEY=

# =============================================================================
# Scheduled jobs
# =============================================================================
# Shared secret for /api/cron/* endpoints. Required in production.
CRON_SECRET=
